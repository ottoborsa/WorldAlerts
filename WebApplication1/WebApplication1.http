
@baseUrl = https://localhost:7232
@userId = user-123
@alertId = 1

### 1. Get all alerts for user

GET {{baseUrl}}/api/users/{{userId}}/alerts
Accept: application/json

### 2. Create an alert (Email + Slack)
# @name createAlert
POST {{baseUrl}}/api/users/{{userId}}/alerts
Content-Type: application/json

{
  "name": "Breaking technology news",
  "keywords": ["AI", "Microsoft", "OpenAI"],
  "categories": ["news"],
  "channels": ["email", "slack"]
}

### 3. Get alerts again to verify creation
GET {{baseUrl}}/api/users/{{userId}}/alerts
Accept: application/json

### 4. Update an alert
PUT {{baseUrl}}/api/users/{{userId}}/alerts/{{alertId}}
Content-Type: application/json

{
  "name": "Updated technology alert",
  "keywords": ["AI", "Azure"],
  "categories": ["news", "technology"],
  "channels": ["email"],
  "enabled": true
}

### 5. Disable an alert
PUT {{baseUrl}}/api/users/{{userId}}/alerts/{{alertId}}
Content-Type: application/json

{
  "name": "Updated technology alert",
  "keywords": ["AI", "Azure"],
  "categories": ["news", "technology"],
  "channels": ["email"],
  "enabled": false
}

### 6. Submit a matching event
POST {{baseUrl}}/api/events
Content-Type: application/json

{
  "title": "OpenAI announces new AI technology",
  "description": "Microsoft and OpenAI reveal a new AI development.",
  "category": "news"
}

### 7. Submit a non-matching event
POST {{baseUrl}}/api/events
Content-Type: application/json

{
  "title": "Major earthquake reported",
  "description": "Emergency services respond to an earthquake.",
  "category": "disaster"
}

### 8. Admin: list all alerts
GET {{baseUrl}}/api/admin/alerts
Accept: application/json

### 9. Admin: inspect delivery attempts
GET {{baseUrl}}/api/admin/deliveries
Accept: application/json

### 10. Delete an alert
DELETE {{baseUrl}}/api/users/{{userId}}/alerts/{{alertId}}

### 11. Verify deletion
GET {{baseUrl}}/api/users/{{userId}}/alerts
Accept: application/json
