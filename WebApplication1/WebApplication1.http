
@baseUrl = https://localhost:7232
@userId = user-123
@alertId = 1

### 1. List alerts before testing
GET {{baseUrl}}/api/users/{{userId}}/alerts
Accept: application/json

### 2. Create an alert
# Copy the returned id into @alertId above before continuing.
POST {{baseUrl}}/api/users/{{userId}}/alerts
Content-Type: application/json

{
  "name": "Breaking technology news",
  "keywords": ["AI", "Microsoft", "OpenAI"],
  "categories": ["news"],
  "channels": ["email", "slack"]
}

### 3. List alerts and verify creation
GET {{baseUrl}}/api/users/{{userId}}/alerts
Accept: application/json

### 4. Update the alert
PUT {{baseUrl}}/api/users/{{userId}}/alerts/{{alertId}}
Content-Type: application/json

{
  "name": "Updated technology alert",
  "keywords": ["AI", "Azure"],
  "categories": ["news", "technology"],
  "channels": ["email"],
  "enabled": true
}

### 5. Submit a matching event
# Should attempt one notification for the enabled alert.
POST {{baseUrl}}/api/events
Content-Type: application/json

{
  "title": "OpenAI announces new AI technology",
  "description": "Microsoft and OpenAI reveal a new AI development.",
  "category": "news"
}

### 6. Submit a non-matching event
# Should not match the updated keywords.
POST {{baseUrl}}/api/events
Content-Type: application/json

{
  "title": "Major earthquake reported",
  "description": "Emergency services respond to an earthquake.",
  "category": "disaster"
}

### 7. Inspect delivery attempts
GET {{baseUrl}}/api/admin/deliveries
Accept: application/json

### 8. Disable the alert
PUT {{baseUrl}}/api/users/{{userId}}/alerts/{{alertId}}
Content-Type: application/json

{
  "name": "Updated technology alert",
  "keywords": ["AI", "Azure"],
  "categories": ["news", "technology"],
  "channels": ["email"],
  "enabled": false
}

### 9. Submit a matching event while alert is disabled
# Should attempt zero notifications if no other alerts match.
POST {{baseUrl}}/api/events
Content-Type: application/json

{
  "title": "Azure announces new AI technology",
  "description": "A new AI development is announced.",
  "category": "news"
}

### 10. List all alerts (admin)
GET {{baseUrl}}/api/admin/alerts
Accept: application/json

### 11. Delete the alert
DELETE {{baseUrl}}/api/users/{{userId}}/alerts/{{alertId}}

### 12. Verify deletion
GET {{baseUrl}}/api/users/{{userId}}/alerts
Accept: application/json

### 13. Verify missing alert returns 404
DELETE {{baseUrl}}/api/users/{{userId}}/alerts/{{alertId}}


### 14. Channel validation: uppercase EMAIL should be accepted and normalized
POST {{baseUrl}}/api/users/{{userId}}/alerts
Content-Type: application/json

{
  "name": "Uppercase channel test",
  "keywords": ["test"],
  "categories": [],
  "channels": ["EMAIL"]
}

### 15. Channel validation: unregistered channel should be rejected
POST {{baseUrl}}/api/users/{{userId}}/alerts
Content-Type: application/json

{
  "name": "Unsupported channel test",
  "keywords": ["test"],
  "categories": [],
  "channels": ["telegram"]
}
